#usda 1.0
(
    defaultPrim = "RobotStation"
    doc = "Robot Station assembly interface decoupling robot arm, end-effector tool, and pedestal mount."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "RobotStation" (
    prepend apiSchemas = ["GeomModelAPI", "IsaacRobotAPI"]
    kind = "assembly"
    variants = {
        string EndEffector = "Robotiq_2F_85"
    }
    variantSets = "EndEffector"
)
{
    float3[] extentsHint = [(-0.25, -1.230202, 0), (0.392275, 0.25, 1.21523), (-0.25, -1.230202, 0), (0.392275, 0.25, 1.21523), (-0.25, -1.230202, 0), (0.392275, 0.25, 1.21523), (-7.500002, -8.750005, -29.471994), (7.676002, 8.750005, 31.727993)]
    string isaac:description = "Universal Robots UR10 Robot Workstation with Robotiq 2F-85 Gripper"
    string isaac:namespace = "/RobotStation"
    token isaac:robotType = "manipulator"
    string isaac:version = "1.0.0"

    def "Robot_Base" (
        prepend apiSchemas = ["GeomModelAPI"]
        displayName = "Robot_Base"
        kind = "component"
        prepend payload = @./robot_base/Robot_Base.usd@
    )
    {
        float3[] extentsHint = [(-0.25, -0.25, 0), (0.25, 0.25, 1), (-0.25, -0.25, 0), (0.25, 0.25, 1), (-0.25, -0.25, 0), (0.25, 0.25, 1), (-0.005, -0.215, 0.055), (0.005, 0.215, 0.065)]
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:scale:unitsResolve = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale", "xformOp:scale:unitsResolve"]
        custom token workcell:mounting = "static"

        over "Robot_Base"
        {
            over "tn__Part1_f5"
            {
                over "Mesh" (
                    delete apiSchemas = ["PhysicsRigidBodyAPI"]
                )
                {
                }
            }
        }
    }

    def "ur10" (
        prepend payload = @./ur10/simready_isaac_usd/ur10.usda@
    )
    {
        string isaac:namespace (
            displayName = "Namespace"
            doc = "Namespace of the prim in Isaac Sim"
        )
        token visibility = "inherited"
        quatd xformOp:orient = (0.7071067811865475, 0, 0, -0.7071067811865476)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "wrist_3_link"
        {
            string isaac:nameOverride (
                displayName = "Name Override"
                doc = "Name override for prim lookup in base name search"
            )
            quatd xformOp:orient = (-3.0908612941134904e-8, 3.0908622776391856e-8, -0.7071067811865469, -0.7071067811865469)
            double3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (1.1842999458312988, 0.2561410665512085, 0.011599980294704437)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        over "wrist_2_link"
        {
            string isaac:nameOverride (
                displayName = "Name Override"
                doc = "Name override for prim lookup in base name search"
            )
        }

        over "base_link"
        {
        }

        over "shoulder_link"
        {
        }

        over "upper_arm_link"
        {
        }

        over "forearm_link"
        {
        }

        over "wrist_1_link"
        {
        }

        over "joints"
        {
            over "shoulder_pan_joint"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "shoulder_lift_joint"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "elbow_joint"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "wrist_1_joint"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "wrist_2_joint"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            over "wrist_3_joint"
            {
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }
        }
    }

    variantSet "EndEffector" = {
        "None" {
            rel isaac:physics:robotJoints = [
                </RobotStation/ur10/root_joint>,
                </RobotStation/ur10/joints/shoulder_pan_joint>,
                </RobotStation/ur10/joints/shoulder_lift_joint>,
                </RobotStation/ur10/joints/elbow_joint>,
                </RobotStation/ur10/joints/wrist_1_joint>,
                </RobotStation/ur10/joints/wrist_2_joint>,
                </RobotStation/ur10/joints/wrist_3_joint>,
            ]
            rel isaac:physics:robotLinks = [
                </RobotStation/ur10/base_link>,
                </RobotStation/ur10/shoulder_link>,
                </RobotStation/ur10/upper_arm_link>,
                </RobotStation/ur10/forearm_link>,
                </RobotStation/ur10/wrist_1_link>,
                </RobotStation/ur10/wrist_2_link>,
                </RobotStation/ur10/wrist_3_link>,
            ]
        }
        "Robotiq_2F_85" {
            rel isaac:physics:robotJoints = [
                </RobotStation/ur10/root_joint>,
                </RobotStation/ur10/joints/shoulder_pan_joint>,
                </RobotStation/ur10/joints/shoulder_lift_joint>,
                </RobotStation/ur10/joints/elbow_joint>,
                </RobotStation/ur10/joints/wrist_1_joint>,
                </RobotStation/ur10/joints/wrist_2_joint>,
                </RobotStation/ur10/joints/wrist_3_joint>,
                </RobotStation/ToolMountJoint>,
                </RobotStation/Robotiq_2F_85/Joints/finger_joint>,
                </RobotStation/Robotiq_2F_85/Joints/right_outer_knuckle_joint>,
                </RobotStation/Robotiq_2F_85/Joints/right_inner_finger_joint>,
                </RobotStation/Robotiq_2F_85/Joints/right_inner_finger_knuckle_joint>,
                </RobotStation/Robotiq_2F_85/Joints/left_inner_finger_knuckle_joint>,
                </RobotStation/Robotiq_2F_85/Joints/left_inner_finger_joint>,
            ]
            rel isaac:physics:robotLinks = [
                </RobotStation/ur10/base_link>,
                </RobotStation/ur10/shoulder_link>,
                </RobotStation/ur10/upper_arm_link>,
                </RobotStation/ur10/forearm_link>,
                </RobotStation/ur10/wrist_1_link>,
                </RobotStation/ur10/wrist_2_link>,
                </RobotStation/ur10/wrist_3_link>,
                </RobotStation/Robotiq_2F_85/base_link>,
                </RobotStation/Robotiq_2F_85/left_outer_knuckle>,
                </RobotStation/Robotiq_2F_85/left_outer_finger>,
                </RobotStation/Robotiq_2F_85/left_inner_finger>,
                </RobotStation/Robotiq_2F_85/left_inner_knuckle>,
                </RobotStation/Robotiq_2F_85/right_outer_knuckle>,
                </RobotStation/Robotiq_2F_85/right_outer_finger>,
                </RobotStation/Robotiq_2F_85/right_inner_finger>,
                </RobotStation/Robotiq_2F_85/right_inner_knuckle>,
            ]

            def "Robotiq_2F_85" (
                delete apiSchemas = ["PhysicsArticulationRootAPI"]
                prepend payload = @./Robotiq/2F-85/simready_isaac_usd/Robotiq_2F_85.usda@
            )
            {
                string isaac:namespace (
                    displayName = "Namespace"
                    doc = "Namespace of the prim in Isaac Sim"
                )
                quatd xformOp:orient = (0.5, -0.5, 0.5, -0.5)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0.243854386794641, -1.182999968528834, 1.0160504896194087)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

                over "base_link"
                {
                    string isaac:nameOverride (
                        displayName = "Name Override"
                        doc = "Name override for prim lookup in base name search"
                    )
                }

                over "left_outer_knuckle"
                {
                }

                over "left_outer_finger"
                {
                }

                over "left_inner_finger"
                {
                }

                over "left_inner_knuckle"
                {
                }

                over "right_outer_knuckle"
                {
                }

                over "right_outer_finger"
                {
                }

                over "right_inner_finger"
                {
                }

                over "right_inner_knuckle"
                {
                }

                over "Joints"
                {
                    over "finger_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "right_outer_knuckle_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_inner_finger_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "right_inner_finger_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "left_inner_finger_knuckle_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }

                    over "right_inner_finger_knuckle_joint"
                    {
                        float state:angular:physics:position = 0
                        float state:angular:physics:velocity = 0
                    }
                }
            }

            def PhysicsFixedJoint "ToolMountJoint" (
                prepend apiSchemas = ["IsaacJointAPI"]
            )
            {
                rel physics:body0 = </RobotStation/ur10/wrist_3_link>
                rel physics:body1 = </RobotStation/Robotiq_2F_85/base_link>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (0, 0, 0)
                point3f physics:localPos1 = (0.0012999773, 0.0044505093, 0.01228668)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (4.371139e-8, -6.7975677e-15, -9.7144515e-17, 1)
            }
        }
        "Vacuum_Gripper" {
            custom token workcell:toolStatus = "placeholder"
            string isaac:description = "UR10 station with unimplemented Vacuum_Gripper placeholder: no tool or mounting joint."
            rel isaac:physics:robotJoints = [
                </RobotStation/ur10/root_joint>,
                </RobotStation/ur10/joints/shoulder_pan_joint>,
                </RobotStation/ur10/joints/shoulder_lift_joint>,
                </RobotStation/ur10/joints/elbow_joint>,
                </RobotStation/ur10/joints/wrist_1_joint>,
                </RobotStation/ur10/joints/wrist_2_joint>,
                </RobotStation/ur10/joints/wrist_3_joint>,
            ]
            rel isaac:physics:robotLinks = [
                </RobotStation/ur10/base_link>,
                </RobotStation/ur10/shoulder_link>,
                </RobotStation/ur10/upper_arm_link>,
                </RobotStation/ur10/forearm_link>,
                </RobotStation/ur10/wrist_1_link>,
                </RobotStation/ur10/wrist_2_link>,
                </RobotStation/ur10/wrist_3_link>,
            ]
        }
    }
}
