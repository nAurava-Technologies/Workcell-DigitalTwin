        )
        {
            custom int inputs:value = 1
            token node:type = "omni.graph.nodes.ConstantInt"
            int node:typeVersion = 1
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (90.61896, -208.06543)
        }

        def OmniGraphNode "delay" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom double inputs:duration = 10
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            delete uint inputs:execIn.connect = </World/ActionGraph/once.outputs:once>
            prepend uint inputs:execIn.connect = [
                </World/ActionGraph/on_impulse_event.outputs:execOut>,
                </World/ActionGraph/on_stage_event.outputs:execOut>,
            ]
            token node:type = "omni.graph.action.Delay"
            int node:typeVersion = 2
            custom uint outputs:finished (
                customData = {
                    bool isExecution = 1
                }
            )
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-162.2718, -97.12741)
        }

        def OmniGraphNode "once" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            custom uint inputs:reset (
                customData = {
                    bool isExecution = 1
                }
            )
            token node:type = "omni.graph.action.Once"
            int node:typeVersion = 2
            custom uint outputs:after (
                customData = {
                    bool isExecution = 1
                }
            )
            custom uint outputs:once (
                customData = {
                    bool isExecution = 1
                }
            )
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (-417.71667, -213.86707)
        }
